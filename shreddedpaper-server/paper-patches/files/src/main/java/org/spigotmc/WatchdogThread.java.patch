+    private void dumpLongRunningRegionTicks(final List<RegionTickScheduler.LongRunningRegionTick> ticks, final Logger logger) {
+        if (ticks.isEmpty()) {
+            return;
+        }
+        logger.log(Level.SEVERE, "Long-running independent region ticks:");
+        for (final RegionTickScheduler.LongRunningRegionTick tick : ticks) {
+            logger.log(Level.SEVERE, "\t" + tick.world() + " region=" + tick.regionPos() + " elapsedMs=" + TimeUnit.NANOSECONDS.toMillis(tick.elapsedNanos()) + " thread=" + tick.threadName());
+            final ThreadInfo thread = ManagementFactory.getThreadMXBean().getThreadInfo(tick.threadId(), Integer.MAX_VALUE);
+            if (thread != null) {
+                WatchdogThread.dumpThread(thread, logger);
+            }
+        }
+    }
