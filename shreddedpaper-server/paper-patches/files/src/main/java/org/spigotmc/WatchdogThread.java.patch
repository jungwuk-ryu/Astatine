+    // ShreddedPaper start
+    private void shutdownStalledServer(final MinecraftServer server, final Logger logger) {
+        if (server.hasFullyShutdown) {
+            return;
+        }
+
+        server.forceTicks = true;
+        if (this.restart) {
+            RestartCommand.addShutdownHook(SpigotConfig.restartScript);
+        }
+        server.abnormalExit = true;
+        // Try one last chance to safe shutdown on main in case it comes back.
+        server.safeShutdown(false, this.restart);
+
+        try {
+            Thread.sleep(1000L);
+        } catch (final InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+        }
+
+        if (!server.hasStopped()) {
+            final Thread shutdownThread = new Thread(() -> {
+                try {
+                    server.close();
+                } catch (final Throwable throwable) {
+                    logger.log(Level.SEVERE, "Exception stopping the server after watchdog timeout", throwable);
+                }
+            }, "Watchdog Server Shutdown");
+            shutdownThread.setDaemon(false);
+            shutdownThread.start();
+        }
+
+        final long deadline = WatchdogThread.monotonicMillis() + EMERGENCY_SHUTDOWN_GRACE_MS;
+        while (!server.hasFullyShutdown && WatchdogThread.monotonicMillis() < deadline) {
+            try {
+                Thread.sleep(250L);
+            } catch (final InterruptedException interrupted) {
+                Thread.currentThread().interrupt();
+                break;
+            }
+        }
+
+        if (!server.hasFullyShutdown) {
+            logger.log(Level.SEVERE, "------------------------------");
+            logger.log(Level.SEVERE, "Watchdog emergency shutdown did not complete after " + EMERGENCY_SHUTDOWN_GRACE_MS + "ms; forcing JVM exit.");
+            logger.log(Level.SEVERE, "Final emergency thread dump:");
+            try {
+                for (final ThreadInfo thread : ManagementFactory.getThreadMXBean().dumpAllThreads(true, true)) {
+                    WatchdogThread.dumpThread(thread, logger);
+                }
+            } catch (final Throwable throwable) {
+                logger.log(Level.SEVERE, "Failed to write final emergency thread dump", throwable);
+            }
+            logger.log(Level.SEVERE, "------------------------------");
+            WatchdogThread.forceExitAfterWatchdogTimeout();
+        }
+    }
