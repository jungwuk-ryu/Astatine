+    private List<RegionTickScheduler.LongRunningRegionTick> getLongRunningRegionTicks(final MinecraftServer server) {
+        if (DISABLE_WATCHDOG || this.timeoutTime <= 0L || !WatchdogThread.hasStarted || server.hasStopped()) {
+            return List.of();
+        }
+        final RegionTickScheduler scheduler = RegionTickScheduler.getIfStarted();
+        if (scheduler == null) {
+            return List.of();
+        }
+        return scheduler.longRunningTicks(TimeUnit.MILLISECONDS.toNanos(this.timeoutTime));
+    }
