+            final java.util.Timer timer = new java.util.Timer("Watchdog Forced Halt");
+            timer.schedule(new java.util.TimerTask() {
+                @Override
+                public void run() {
+                    Runtime.getRuntime().halt(70);
+                }
+            }, 10_000L);
+            System.exit(70);
+        } catch (final Throwable throwable) {
+            Runtime.getRuntime().halt(70);
+        }
+    }
