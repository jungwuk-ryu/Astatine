@@ -220,27 +220,31 @@ public interface BlockGetter extends LevelHeightAccessor {
 
             return true;
         } else {
-            LongSet set = new LongOpenHashSet();
+            LongOpenHashSet set = io.multipaper.shreddedpaper.entity.BlockIntersectionScratch.acquire();
+            try { // Astatine - nested visitors get separate scratch; release on early return and failure
 
-            for (BlockPos blockPos1 : BlockPos.betweenCornersInDirection(boundingBox.move(vec3.scale(-1.0)), vec3)) {
-                if (!visitor.visit(blockPos1, 0)) {
-                    return false;
-                }
-
-                set.add(blockPos1.asLong());
-            }
-
-            int i = addCollisionsAlongTravel(set, vec3, boundingBox, visitor);
-            if (i < 0) {
-                return false;
-            } else {
-                for (BlockPos blockPos2 : BlockPos.betweenCornersInDirection(boundingBox, vec3)) {
-                    if (set.add(blockPos2.asLong()) && !visitor.visit(blockPos2, i + 1)) {
+                for (BlockPos blockPos1 : BlockPos.betweenCornersInDirection(boundingBox.move(vec3.scale(-1.0)), vec3)) {
+                    if (!visitor.visit(blockPos1, 0)) {
                         return false;
                     }
+
+                    set.add(blockPos1.asLong());
                 }
 
-                return true;
+                int i = addCollisionsAlongTravel(set, vec3, boundingBox, visitor);
+                if (i < 0) {
+                    return false;
+                } else {
+                    for (BlockPos blockPos2 : BlockPos.betweenCornersInDirection(boundingBox, vec3)) {
+                        if (set.add(blockPos2.asLong()) && !visitor.visit(blockPos2, i + 1)) {
+                            return false;
+                        }
+                    }
+
+                    return true;
