+            } finally {
+                io.multipaper.shreddedpaper.entity.BlockIntersectionScratch.release(set);
             }
         }
     }
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 0f5b035..b675044 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -1886,6 +1886,18 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         return this.getEntities(entity, boundingBox, EntitySelector.pushableBy(entity));
     }
 
+    // Astatine - retain query order and multipart hooks while stopping at the collision cap.
+    public List<Entity> getPushableEntities(Entity entity, AABB boundingBox, int maxCount) {
+        if (maxCount <= 0) {
+            return List.of();
+        }
+        final Predicate<Entity> pushable = EntitySelector.pushableBy(entity);
+        final List<Entity> result = new java.util.ArrayList<>(Math.min(maxCount, 16));
+        this.getEntities(EntityTypeTest.forClass(Entity.class), boundingBox,
+            candidate -> candidate != entity && pushable.test(candidate), result, maxCount);
+        return result;
+    }
+
     public abstract @Nullable Entity getEntity(int id);
 
     public @Nullable Entity getEntity(UUID uuid) {
