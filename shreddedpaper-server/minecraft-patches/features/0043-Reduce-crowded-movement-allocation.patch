+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4020,7 +4020,11 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             return;
         }
         // Paper end - don't run getEntities if we're not going to use its result
-        List<Entity> pushableEntities = this.level().getPushableEntities(this, this.getBoundingBox());
+        // Astatine - cramming needs the full population; ordinary pushes only consume this prefix.
+        final int collisionLimit = this.level().paperConfig().collisions.maxEntityCollisions;
+        List<Entity> pushableEntities = i <= 0 && collisionLimit > 0
+            ? this.level().getPushableEntities(this, this.getBoundingBox(), collisionLimit)
+            : this.level().getPushableEntities(this, this.getBoundingBox());
         if (!pushableEntities.isEmpty()) {
             if (this.level() instanceof ServerLevel serverLevel) {
                 // Paper - don't run getEntities if we're not going to use its result; moved up
diff --git a/net/minecraft/world/level/BlockGetter.java b/net/minecraft/world/level/BlockGetter.java
