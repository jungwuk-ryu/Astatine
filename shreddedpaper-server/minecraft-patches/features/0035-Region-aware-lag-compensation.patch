From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 27 Apr 2026 12:00:00 +0900
Subject: [PATCH] Add region-aware lag compensation


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 602dcfc..29207db 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -944,12 +946,13 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
             if (this.getGameRules().get(GameRules.ADVANCE_TIME)) {
                 // Purpur start - Configurable daylight cycle
                 int incrementTicks = isBrightOutside() ? this.purpurConfig.daytimeTicks : this.purpurConfig.nighttimeTicks;
+                long lagCompensatedTimeIncrement = io.multipaper.shreddedpaper.util.ShreddedPaperLagCompensation.adjustedDayTimeIncrement(this); // DivineMC - Lag compensation
                 if (incrementTicks != 12000) {
-                    this.preciseTime += 12000 / (double) incrementTicks;
+                    this.preciseTime += (12000 / (double) incrementTicks) * lagCompensatedTimeIncrement;
                     this.setDayTime(this.preciseTime);
                 } else
                 // Purpur end - Configurable daylight cycle
-                this.setDayTime(this.levelData.getDayTime() + 1L);
+                this.setDayTime(this.levelData.getDayTime() + lagCompensatedTimeIncrement); // DivineMC - Lag compensation
             }
         }
     }
