diff --git a/net/minecraft/world/item/Item.java b/net/minecraft/world/item/Item.java
index a97923a..c060fe4 100644
--- a/net/minecraft/world/item/Item.java
+++ b/net/minecraft/world/item/Item.java
@@ -300,12 +300,14 @@ public class Item implements FeatureElement, ItemLike {
     }

     public int getUseDuration(ItemStack stack, LivingEntity entity) {
+        final int originalUseDuration; // DivineMC - Lag compensation
         Consumable consumable = stack.get(DataComponents.CONSUMABLE);
         if (consumable != null) {
-            return consumable.consumeTicks();
+            originalUseDuration = consumable.consumeTicks(); // DivineMC - Lag compensation
         } else {
-            return !stack.has(DataComponents.BLOCKS_ATTACKS) && !stack.has(DataComponents.KINETIC_WEAPON) ? 0 : 72000;
+            originalUseDuration = !stack.has(DataComponents.BLOCKS_ATTACKS) && !stack.has(DataComponents.KINETIC_WEAPON) ? 0 : 72000; // DivineMC - Lag compensation
         }
+        return io.multipaper.shreddedpaper.util.ShreddedPaperLagCompensation.adjustedUseDuration(originalUseDuration, entity); // DivineMC - Lag compensation
     }

     public boolean releaseUsing(ItemStack stack, Level level, LivingEntity entity, int timeLeft) {
diff --git a/net/minecraft/world/level/block/state/BlockBehaviour.java b/net/minecraft/world/level/block/state/BlockBehaviour.java
index ac8466b..1d25fa2 100644
--- a/net/minecraft/world/level/block/state/BlockBehaviour.java
