From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jungwuk-ryu <vojougae35@gmail.com>
Date: Tue, 22 Sep 2026 22:00:00 +0900
Subject: [PATCH] perf: batch tracking packets in owner flush scopes

---
diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index da26090..b1911e6 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -5,6 +5,8 @@ import com.google.common.collect.Queues;
 import com.mojang.logging.LogUtils;
 import io.multipaper.shreddedpaper.config.ShreddedPaperConfiguration;
 import io.multipaper.shreddedpaper.network.NetworkFlushDiagnostics;
+import io.multipaper.shreddedpaper.network.OrderedPacketBatcher;
+import io.multipaper.shreddedpaper.network.RegionPacketFlushScope;
 import io.multipaper.shreddedpaper.privacy.AnonymousMode;
 import io.netty.bootstrap.Bootstrap;
 import io.netty.channel.Channel;
@@ -26,7 +28,6 @@ import io.netty.channel.local.LocalServerChannel;
 import io.netty.handler.flow.FlowControlHandler;
 import io.netty.handler.timeout.ReadTimeoutHandler;
 import io.netty.handler.timeout.TimeoutException;
-import io.netty.util.concurrent.AbstractEventExecutor;
 import java.net.InetSocketAddress;
 import java.net.SocketAddress;
 import java.nio.channels.ClosedChannelException;
@@ -66,6 +67,12 @@ import org.slf4j.Marker;
 import org.slf4j.MarkerFactory;
 
 public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
+    private static final boolean BATCH_TRACKING_PACKETS = !Boolean.getBoolean("astatine.disable-packet-batching");
+    private final OrderedPacketBatcher<Packet<?>> trackingBatcher = new OrderedPacketBatcher<>(
+        packet -> this.doSendPacket(packet, null, false),
+        () -> this.channel.flush(),
+        failure -> this.channel.pipeline().fireExceptionCaught(failure)
+    );
     private static final float AVERAGE_PACKETS_SMOOTHING = 0.75F;
     private static final Logger LOGGER = LogUtils.getLogger();
     public static final Marker ROOT_MARKER = MarkerFactory.getMarker("NETWORK");
@@ -342,7 +349,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
                 inboundConfigurationTask = inboundConfigurationTask.andThen(ctx -> ctx.pipeline().addAfter("decoder", "bundler", packetBundlePacker));
             }
 
-            syncAfterConfigurationChange(this.channel.writeAndFlush(inboundConfigurationTask));
+            syncAfterConfigurationChange(this.writeOrderedConfiguration(inboundConfigurationTask));
         }
     }
 
@@ -358,10 +365,19 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
             }
 
             boolean flag = protocolInfo.id() == ConnectionProtocol.LOGIN;
-            syncAfterConfigurationChange(this.channel.writeAndFlush(outboundConfigurationTask.andThen(ctx -> this.sendLoginDisconnect = flag)));
+            syncAfterConfigurationChange(this.writeOrderedConfiguration(outboundConfigurationTask.andThen(ctx -> this.sendLoginDisconnect = flag)));
         }
     }
 
+    private ChannelFuture writeOrderedConfiguration(Object task) {
+        final ChannelPromise promise = this.channel.newPromise();
+        this.trackingBatcher.execute(this.channel.eventLoop(), () -> {
+            try { this.channel.writeAndFlush(task, promise); }
+            catch (Throwable failure) { promise.tryFailure(failure); }
+        });
+        return promise;
+    }
+
     public void setListenerForServerboundHandshake(PacketListener packetListener) {
         if (this.packetListener != null) {
             throw new IllegalStateException("Listener already set");
@@ -460,18 +476,18 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
 
     private void sendPacket(Packet<?> packet, @Nullable ChannelFutureListener sendListener, boolean flush) {
         this.sentPackets++;
-        if (this.channel.eventLoop().inEventLoop()) {
-            this.doSendPacket(packet, sendListener, flush);
+        final boolean lazy = ShreddedPaperConfiguration.get().optimizations.useLazyExecuteWhenNotFlushing;
+        // Restrict coalescing to small tracking packets without completion hooks.
+        // Large packets, bundles, keepalives and protocol changes remain ordering barriers.
+        if (BATCH_TRACKING_PACKETS && sendListener == null && !packet.hasFinishListener() && !packet.isTerminal()
+            && (packet instanceof net.minecraft.network.protocol.game.ClientboundMoveEntityPacket
+                || packet instanceof net.minecraft.network.protocol.game.ClientboundRotateHeadPacket
+                || packet instanceof net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket
+                || packet instanceof net.minecraft.network.protocol.game.ClientboundTeleportEntityPacket)) {
+            final boolean flushNow = flush && !RegionPacketFlushScope.defer(this);
+            this.trackingBatcher.send(this.channel.eventLoop(), packet, flushNow, lazy);
         } else {
-            // ShreddedPaper start - Use lazyExecute if we are not flushing
-            if (ShreddedPaperConfiguration.get().optimizations.useLazyExecuteWhenNotFlushing && !flush) {
-                ((AbstractEventExecutor) this.channel.eventLoop()).lazyExecute(() -> {
-                    this.doSendPacket(packet, sendListener, flush);
-                });
-                return;
-            }
-            // ShreddedPaper end - Use lazyExecute if we are not flushing
-            this.channel.eventLoop().execute(() -> this.doSendPacket(packet, sendListener, flush));
+            this.trackingBatcher.execute(this.channel.eventLoop(), () -> this.doSendPacket(packet, sendListener, flush), lazy && !flush);
         }
     }
 
@@ -512,17 +528,13 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     public void flushChannel() {
         if (this.isConnected()) {
             this.flush();
-        } else {
+        } else if (this.preparing) {
             this.pendingActions.add(new WrappedConsumer(Connection::flush)); // Paper - Optimize network
         }
     }
 
     private void flush() {
-        if (this.channel.eventLoop().inEventLoop()) {
-            this.channel.flush();
-        } else {
-            this.channel.eventLoop().execute(() -> this.channel.flush());
-        }
+        this.trackingBatcher.execute(this.channel.eventLoop(), () -> this.channel.flush());
     }
 
     // Paper start - Optimize network: Rewrite this to be safer if ran off main thread
@@ -667,8 +679,8 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
         }
 
         if (this.isConnected()) {
-            this.channel.close(); // We can't wait as this may be called from an event loop.
             this.disconnectionDetails = disconnectionDetails;
+            this.trackingBatcher.execute(this.channel.eventLoop(), () -> this.channel.close()); // Ordered, without waiting on the event loop.
         }
     }
 
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
