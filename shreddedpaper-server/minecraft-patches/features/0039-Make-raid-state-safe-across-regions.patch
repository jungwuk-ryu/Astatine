From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jungwuk-ryu <vojougae35@gmail.com>
Date: Sat, 19 Sep 2026 12:00:00 +0900
Subject: [PATCH] fix: make raid state safe across regions

---
diff --git a/net/minecraft/world/entity/raid/Raids.java b/net/minecraft/world/entity/raid/Raids.java
index 78dc2f0..ba99549 100644
--- a/net/minecraft/world/entity/raid/Raids.java
+++ b/net/minecraft/world/entity/raid/Raids.java
@@ -36,3 +36,3 @@ public class Raids extends SavedData {
     private static final String RAID_FILE_ID = "raids";
-    public final java.util.Map<java.util.UUID, Integer> playerCooldowns = com.google.common.collect.Maps.newHashMap(); // Purpur - Raid cooldown setting
+    public final java.util.Map<java.util.UUID, Integer> playerCooldowns = new java.util.concurrent.ConcurrentHashMap<>(); // Astatine - shared across region workers
     public static final Codec<Raids> CODEC = RecordCodecBuilder.create(
@@ -43,3 +43,3 @@ public class Raids extends SavedData {
                     .forGetter(raids -> raids.raidMap.entrySet().stream().map(Raids.RaidWithId::from).toList()), // ShreddedPaper - concurrent map
-                Codec.INT.fieldOf("next_id").forGetter(raids -> raids.nextId),
+                Codec.INT.fieldOf("next_id").forGetter(raids -> raids.nextId.get()),
                 Codec.INT.fieldOf("tick").forGetter(raids -> raids.tick)
@@ -51,3 +51,3 @@ public class Raids extends SavedData {
     public final Map<Integer, Raid> raidMap = Maps.newConcurrentMap(); // ShreddedPaper - concurrent map
-    private int nextId = 1;
+    private final java.util.concurrent.atomic.AtomicInteger nextId = new java.util.concurrent.atomic.AtomicInteger(1);
     private int tick;
@@ -68,3 +68,3 @@ public class Raids extends SavedData {
 
-        this.nextId = nextId;
+        this.nextId.set(nextId);
         this.tick = tick;
@@ -90,9 +90,4 @@ public class Raids extends SavedData {
         if (level.purpurConfig.raidCooldownSeconds != 0 && this.tick % 20 == 0) {
-            com.google.common.collect.ImmutableMap.copyOf(playerCooldowns).forEach((uuid, i) -> {
-                if (i < 1) {
-                    playerCooldowns.remove(uuid);
-                } else {
-                    playerCooldowns.put(uuid, i - 1);
-                }
-            });
+            playerCooldowns.forEach((uuid, ignored) -> playerCooldowns.computeIfPresent(uuid,
+                (key, remaining) -> remaining < 1 ? null : remaining - 1));
         }
@@ -170,4 +165,4 @@ public class Raids extends SavedData {
                     if (!raid.isStarted() && !this.raidMap.containsValue(raid)) {
-                        this.raidMap.put(this.getUniqueId(), raid);
-                        raid.idOrNegativeOne = this.nextId; // Paper - expose id of raids while method is kept around as deprecated for removal
+                        raid.idOrNegativeOne = this.getUniqueId(); // Set the matching ID before publishing the raid.
+                        this.raidMap.put(raid.idOrNegativeOne, raid);
                     }
@@ -193,3 +188,3 @@ public class Raids extends SavedData {
     private int getUniqueId() {
-        return ++this.nextId;
+        return this.nextId.incrementAndGet();
     }
