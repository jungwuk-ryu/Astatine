     boolean setPower() {
+        if (io.multipaper.shreddedpaper.threading.ShreddedPaperTickThread.isShreddedPaperTickThread()
+                && !io.multipaper.shreddedpaper.threading.ownership.ShreddedPaperAccess.isOwned(level, pos)) {
+            final BlockPos queuedPos = this.pos;
+            final BlockState queuedState = this.state;
+            final boolean queuedRemoval = this.removed;
+            final io.multipaper.shreddedpaper.threading.ownership.OwnerTaskResult handoffResult =
+                    io.multipaper.shreddedpaper.threading.ownership.ShreddedPaperAccess.runWithWriteLockIfHeldOrDeferToOwner(
+                            level,
+                            queuedPos,
+                            io.multipaper.shreddedpaper.threading.region.RegionTaskClass.OWNER_HANDOFF,
