+                                if (queuedRemoval) {
+                                    level.getWireHandler().onWireRemoved(queuedPos, queuedState);
+                                    return;
+                                }
+                                final BlockState currentState = level.getBlockStateIfLoaded(queuedPos);
+                                if (currentState != null && currentState.is(Blocks.REDSTONE_WIRE)) {
+                                    level.getWireHandler().onWireUpdated(queuedPos, currentState, null);
+                                }
+                            }
+                    );
+            if (handoffResult == io.multipaper.shreddedpaper.threading.ownership.OwnerTaskResult.REJECTED
+                    || handoffResult == io.multipaper.shreddedpaper.threading.ownership.OwnerTaskResult.CHUNK_UNAVAILABLE) {
+                throw new IllegalStateException("Failed to hand off cross-owner redstone wire update; world=" + level.getWorld().getName() + ", pos=" + queuedPos);
+            }
+            return false;
+        }
