+    private boolean shreddedpaper$canExecuteRegionInternalTasks(final LevelChunkRegion region) {
+        for (final RegionPos ownedRegionPos : region.getOwner().cellPositionsSnapshot()) {
+            if (ShreddedPaperChunkTicker.isCurrentlyTickingRegion(this.world, ownedRegionPos)) {
+                continue;
+            }
+            if (ShreddedPaperConfiguration.get().multithreading.independentRegionTicking) {
+                if (!this.world.chunkScheduler.getRegionLocker().hasWriteLock(ownedRegionPos)) {
+                    return false;
+                }
+            } else if (!this.world.chunkScheduler.getRegionLocker().hasLock(ownedRegionPos)) {
+                return false;
+            }
+        }
+        return true;
+    }
