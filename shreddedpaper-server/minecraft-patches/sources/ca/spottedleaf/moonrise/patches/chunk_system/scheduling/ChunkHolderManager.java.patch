+    // ShreddedPaper start - bounded owner-thread chunk save dispatch
+    private boolean shreddedPaperDispatchChunkAutoSave(final NewChunkHolder holder, final RegionPos saveRegionPos) {
+        if (!holder.shreddedPaperAutoSaveQueued.compareAndSet(false, true)) {
+            holder.shreddedPaperAutoSaveRetry = true;
+            return true;
+        }
+
+        final Runnable saveTask = () -> {
+            boolean completed = false;
+            try {
+                holder.save(false);
+                completed = true;
+            } finally {
+                holder.shreddedPaperAutoSaveQueued.set(false);
+                if (!completed || holder.shreddedPaperAutoSaveRetry) {
+                    holder.shreddedPaperAutoSaveRetry = false;
+                    this.shreddedPaperQueueAutoSaveSoon(holder, Math.max(1L, PlatformHooks.get().configAutoSaveInterval(this.world)));
+                }
+            }
+        };
+
+        final ChunkPos saveChunkPos = new ChunkPos(holder.chunkX, holder.chunkZ);
+        if (TickThread.isShutdownThread() || ShreddedPaper.isSync(holder.world, saveChunkPos)) {
+            saveTask.run();
+            return true;
+        }
+
+        if (holder.world.getChunkSource().tickingRegions.scheduleTaskIfSchedulerArmed(saveRegionPos, saveTask, 0L, RegionTaskClass.CHUNK_IO_SAVE)) {
+            return true;
+        }
+
+        final ShreddedPaperRegionLocker.RegionLock saveLock = holder.world.chunkScheduler.getRegionLocker().tryTakeLockNow(saveRegionPos);
+        if (saveLock != null) {
+            try {
+                saveTask.run();
+            } catch (final Throwable throwable) {
+                LOGGER.error("Error while executing immediate chunk auto-save fallback for chunk {},{} in world '{}'",
+                    holder.chunkX, holder.chunkZ, WorldUtil.getWorldName(this.world), throwable);
+            } finally {
+                saveLock.unlock();
+            }
+            return true;
+        }
+
+        holder.shreddedPaperAutoSaveQueued.set(false);
+        return false;
+    }
+
