+    private void shreddedpaper$tickDeferredExplosion() {
+        this.setFuse(Integer.MAX_VALUE);
+        this.setDeltaMovement(0.0, 0.0, 0.0);
+        if (this.level().isClientSide()) {
+            return;
+        }
+        if (!(this.level() instanceof ServerLevel serverLevel)) {
+            return;
+        }
+        if (!serverLevel.getGameRules().get(GameRules.TNT_EXPLODES)) {
+            this.shreddedpaper$setDeferredExplosion(false);
+            this.discard(EntityRemoveEvent.Cause.EXPLODE);
+            return;
+        }
+        final RegionTickBudget budget = RegionTickBudget.current();
+        if (budget != null && !budget.canDrainDeferred(RegionWorkType.EXPLOSION)) {
+            return;
+        }
+        if (!this.shreddedpaper$canRunExplosionNow(
+            serverLevel,
+            this.shreddedpaper$deferredExplosionX,
+            this.shreddedpaper$deferredExplosionY,
+            this.shreddedpaper$deferredExplosionZ,
+            this.shreddedpaper$deferredExplosionRadius
+        )) {
+            this.shreddedpaper$scheduleDeferredExplosion(serverLevel);
+            return;
+        }
+        this.shreddedpaper$setDeferredExplosion(false);
+        this.runDeferredExplosion(
+            serverLevel,
+            this.shreddedpaper$deferredExplosionX,
+            this.shreddedpaper$deferredExplosionY,
+            this.shreddedpaper$deferredExplosionZ,
+            this.shreddedpaper$deferredExplosionRadius,
+            this.shreddedpaper$deferredExplosionFire,
+            this.shreddedpaper$deferredExplosionPortalCalculator
+        );
+        this.discard(EntityRemoveEvent.Cause.EXPLODE);
+    }
+
+    private boolean shreddedpaper$canRunExplosionNow(
