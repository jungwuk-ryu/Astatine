+        final int reach = Mth.ceil(radius * 2.0F) + 2;
+        return net.minecraft.world.level.levelgen.structure.BoundingBox.fromCorners(
+            BlockPos.containing(x - reach, y - reach, z - reach),
+            BlockPos.containing(x + reach, y + reach, z + reach)
+        );
+    }
