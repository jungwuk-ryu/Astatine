+    private boolean shreddedpaper$acquireDeferredExplosionSlot(final ServerLevel serverLevel) {
+        if (this.shreddedpaper$deferredExplosionSlotCounted) {
+            return true;
+        }
+        final int limit = Math.max(0, ShreddedPaperConfiguration.get().multithreading.deferredTntBacklogPerWorld);
+        if (limit == 0) {
+            shreddedpaper$recordDroppedDeferredExplosion(serverLevel, limit);
+            return false;
+        }
+        final AtomicInteger counter = shreddedpaper$deferredExplosionCounter(serverLevel);
+        int current;
+        do {
+            current = counter.get();
+            if (current >= limit) {
+                shreddedpaper$recordDroppedDeferredExplosion(serverLevel, limit);
+                return false;
+            }
+        } while (!counter.compareAndSet(current, current + 1));
+        this.shreddedpaper$deferredExplosionSlotCounted = true;
+        return true;
+    }
+
+    private static void shreddedpaper$recordDroppedDeferredExplosion(final ServerLevel serverLevel, final int limit) {
+        final int dropped = SHREDDEDPAPER_DROPPED_DEFERRED_EXPLOSIONS.incrementAndGet();
+        if ((dropped & 255) == 0) {
+            MinecraftServer.LOGGER.warn("Dropped {} deferred TNT explosions in world '{}' after reaching deferredTntBacklogPerWorld={}", dropped, serverLevel.getWorld().getName(), limit);
+        }
+    }
