+    ) {
+        return !ShreddedPaperConfiguration.get().multithreading.independentRegionTicking
+            || io.multipaper.shreddedpaper.ShreddedPaper.isSync(
+                serverLevel,
+                shreddedpaper$explosionOwnershipBox(explosionX, explosionY, explosionZ, radius)
+            );
+    }
+
+    private void shreddedpaper$scheduleDeferredExplosion(final ServerLevel serverLevel) {
+        if (this.shreddedpaper$deferredExplosionExecutionQueued) {
+            return;
+        }
+        this.shreddedpaper$deferredExplosionExecutionQueued = true;
+        final double explosionX = this.shreddedpaper$deferredExplosionX;
+        final double explosionY = this.shreddedpaper$deferredExplosionY;
+        final double explosionZ = this.shreddedpaper$deferredExplosionZ;
+        final float radius = this.shreddedpaper$deferredExplosionRadius;
+        final boolean fire = this.shreddedpaper$deferredExplosionFire;
+        final boolean usedPortalDamageCalculator = this.shreddedpaper$deferredExplosionPortalCalculator;
+        io.multipaper.shreddedpaper.ShreddedPaper.runSync(
+            serverLevel,
+            shreddedpaper$explosionOwnershipBox(explosionX, explosionY, explosionZ, radius),
+            () -> {
+                this.shreddedpaper$deferredExplosionExecutionQueued = false;
+                if (!this.shreddedpaper$isDeferredExplosion() || this.isRemoved() || this.level() != serverLevel) {
+                    return;
+                }
+                final RegionTickBudget budget = RegionTickBudget.current();
+                if (budget != null && !budget.canDrainDeferred(RegionWorkType.EXPLOSION)) {
+                    return;
+                }
+                if (!this.shreddedpaper$canRunExplosionNow(serverLevel, explosionX, explosionY, explosionZ, radius)) {
+                    this.shreddedpaper$scheduleDeferredExplosion(serverLevel);
+                    return;
+                }
+                this.shreddedpaper$setDeferredExplosion(false);
+                this.runDeferredExplosion(serverLevel, explosionX, explosionY, explosionZ, radius, fire, usedPortalDamageCalculator);
+                this.discard(EntityRemoveEvent.Cause.EXPLODE);
+            }
+        );
+    }
