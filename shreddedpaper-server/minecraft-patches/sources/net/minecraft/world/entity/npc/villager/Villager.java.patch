+    private Predicate<Holder<PoiType>> poiReleasePredicate(MemoryModuleType<GlobalPos> moduleType) {
+        if (moduleType == MemoryModuleType.HOME) {
+            return poiType -> poiType.is(PoiTypes.HOME);
+        }
+        if (moduleType == MemoryModuleType.JOB_SITE) {
+            final Holder<VillagerProfession> profession = this.getVillagerData().profession();
+            return poiType -> profession.value().heldJobSite().test(poiType);
+        }
+        if (moduleType == MemoryModuleType.POTENTIAL_JOB_SITE) {
+            return VillagerProfession.ALL_ACQUIRABLE_JOBS;
+        }
+        if (moduleType == MemoryModuleType.MEETING_POINT) {
+            return poiType -> poiType.is(PoiTypes.MEETING);
+        }
+        return poiType -> false;
+    }
