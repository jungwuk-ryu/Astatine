+        final double maxX = (currentRegion.getUpperChunkX() + 1) * 16.0D - 1.0E-7D;
+        final double minZ = currentRegion.getLowerChunkZ() * 16.0D + 1.0E-7D;
+        final double maxZ = (currentRegion.getUpperChunkZ() + 1) * 16.0D - 1.0E-7D;
