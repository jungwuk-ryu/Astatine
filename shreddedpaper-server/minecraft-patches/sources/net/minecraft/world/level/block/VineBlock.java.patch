+    private static boolean isEmptyBlockIfLoaded(BlockGetter level, BlockPos pos) {
+        BlockState state = getBlockStateIfLoadedOrNull(level, pos);
+        return state != null && state.isAir();
+    }
+
+    private static @Nullable BlockState getBlockStateIfLoadedOrNull(BlockGetter level, BlockPos pos) {
+        if (level instanceof LevelReader levelReader && !levelReader.hasChunkAt(pos)) {
+            return null;
+        }
+
+        try {
+            return level.getBlockStateIfLoaded(pos);
+        } catch (ReportedException exception) {
+            if (isWorldGenChunkUnavailable(exception)) {
+                return null;
+            }
+
+            throw exception;
+        } catch (IllegalStateException exception) {
+            if (isWorldGenChunkUnavailable(exception)) {
+                return null;
+            }
+
+            throw exception;
+        }
+    }
+
+    private static boolean isWorldGenChunkUnavailable(Throwable throwable) {
+        for (Throwable current = throwable; current != null; current = current.getCause()) {
+            String message = current.getMessage();
+            if (message != null && message.contains("Requested chunk unavailable during world generation")) {
+                return true;
+            }
+        }
+
+        return false;
+    }
